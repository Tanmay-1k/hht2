# ---- Mode switch ----
# "mock" runs the whole pipeline with no external calls (default, works out of the box)
# "live" uses real Sarvam/ElevenLabs + LLM APIs
PIPELINE_MODE=mock

# ---- Speech-to-Text (pick ONE provider) ----
STT_PROVIDER=sarvam          # sarvam | elevenlabs | mock
SARVAM_API_KEY=your_sarvam_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ---- Generation LLM ----
# sarvam reuses your SARVAM_API_KEY above (one free-tier account covers STT + generation).
# Switch to anthropic/openai only if you specifically want those models and are OK with paid billing.
LLM_PROVIDER=sarvam
LLM_API_KEY=
LLM_MODEL=sarvam-105b

# ---- Vector DB / embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_PATH=./data/faiss.index
VECTOR_METADATA_PATH=./data/metadata.jsonl

# ---- Chunking ----
CHUNK_STRATEGY=hybrid        # fixed | recursive | semantic | metadata_aware | hybrid
CHUNK_SIZE=256
CHUNK_OVERLAP=48

# ---- Guardrails ----
GROUNDING_MIN_OVERLAP=0.35
OFFTOPIC_MIN_SIMILARITY=0.28
